#!/bin/bash

set -euo pipefail

REPO=/var/repositories/oksana-vpn-ui.git
TARGET=/var/apps/oksana-vpn-ui
BRANCH=main
UPDATED=false

while read -r old_revision new_revision ref_name; do
    if [[ "$ref_name" == "refs/heads/$BRANCH" && "$new_revision" != "0000000000000000000000000000000000000000" ]]; then
        UPDATED=true
    fi
done

if [[ "$UPDATED" != true ]]; then
    exit 0
fi

git --git-dir="$REPO" --work-tree="$TARGET" checkout -f "$BRANCH"
cd "$TARGET"

docker compose build ui
docker compose up -d --no-deps ui

for attempt in {1..30}; do
    health=$(docker inspect oksana-vpn-ui --format '{{.State.Health.Status}}' 2>/dev/null || true)
    if [[ "$health" == healthy ]]; then
        curl --fail --silent --show-error --output /dev/null http://194.147.215.202:8082/
        echo "UI deployed at http://194.147.215.202:8082/"
        exit 0
    fi
    if [[ "$health" == unhealthy ]]; then
        break
    fi
    sleep 1
done

echo "UI failed its Docker health check" >&2
docker logs --tail 40 oksana-vpn-ui >&2
exit 1
